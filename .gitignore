# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
Thumbs.db

# MCP cache
docs-cache/

# TWA - ignore build artifacts and user-generated config
twa/app/
twa/build/
twa/.gradle/
twa/gradle/
twa/gradlew
twa/gradlew.bat
twa/build.gradle
twa/settings.gradle
twa/gradle.properties
twa/*.apk
twa/*.aab
twa/*.idsig
twa/android.keystore
twa/store_icon.png
twa/manifest-checksum.txt
twa/twa-manifest.json

# Keep these TWA template files:
# - twa/twa-manifest.template.json (template)
# - twa/CustomLauncherActivity.java
# - twa/scripts/*.sh
# - twa/README.md

# Docs site
docs-site/node_modules/
docs-site/docs/.vitepress/*
!docs-site/docs/.vitepress/config.mts
